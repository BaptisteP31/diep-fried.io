  "proceduralGeometryRules": {
    "regularPolygon": {
      "description": "Calcul trigonométrique des sommets d'une forme à N côtés réguliers centrée en (cx, cy) avec rayon R et angle d'orientation alpha.",
      "vertexFormula": "x_i = cx + R * cos(alpha + i * 2 * PI / N), y_i = cy + R * sin(alpha + i * 2 * PI / N)",
      "strokeRatio": "borderThickness = R * 0.08 ou fixe selon niveau de zoom",
      "fillBeforeStroke": true
    },
    "tankBody": {
      "description": "Cercle parfait tracé via arc()",
      "path": "ctx.arc(cx, cy, radius, 0, 2 * Math.PI)",
      "fill": "Couleur d'équipe ou de joueur",
      "stroke": "Contour sombre 25% noir ou #555555"
    },
    "tankBarrel": {
      "description": "Canon tracé comme rectangle ou trapèze avec décalage angulaire et animation de recul",
      "drawingCoordinates": "Point d'ancrage au centre du tank (0,0), translate + rotate(barrelAngle)",
      "recoilAnimation": "offset_x = length - recoilAmount * (1 - progress)",
      "shapeTypes": [
        {
          "name": "straight",
          "params": [
            "length",
            "width"
          ]
        },
        {
          "name": "trapezoid_expanding",
          "params": [
            "length",
            "baseWidth",
            "tipWidth"
          ],
          "description": "Machine Gun, Destroyer, Annihilator"
        },
        {
          "name": "trapezoid_contracting",
          "params": [
            "length",
            "baseWidth",
            "tipWidth"
          ],
          "description": "Hunter, Predator"
        }
      ]
    }
  },
