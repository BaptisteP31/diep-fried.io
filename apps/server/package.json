{
  "name": "@diep-fried/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Serveur Node : salons, WebSocket de jeu, santé HTTP et fichiers du client construit.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:ws --sourcemap --outfile=dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@diep-fried/shared": "0.0.0",
    "@diep-fried/sim": "0.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  },
  "license": "AGPL-3.0-or-later"
}
